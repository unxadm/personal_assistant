# Copy to .env. Docker Compose reads it by itself; otherwise load it into the environment
# with `set -a; . ./.env; set +a`. Do not commit .env.

# Encrypts API keys / OAuth tokens stored in the database. Any long random string, e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# If unset, a key is generated at <data_dir>/secret.key. Losing it makes stored secrets unreadable.
PA_SECRET_KEY=

# Docker only: the user the container runs as (must own ./data). Default 1000:1000.
# PA_UID=1000
# PA_GID=1000

# Path to the YAML config (default: ./config.yaml if it exists)
# PA_CONFIG=./config.yaml

PA_LLM__CHAT__API_KEY=
# PA_LLM__CHAT__BASE_URL=https://api.openai.com/v1
# PA_LLM__CHAT__MODEL=gpt-4o-mini
# PA_LLM__EMBEDDINGS__MODEL=text-embedding-3-small
# PA_TIMEZONE=Europe/Oslo

# Google OAuth client (Gmail and Calendar plugins)
PA_OAUTH__GOOGLE__CLIENT_ID=
PA_OAUTH__GOOGLE__CLIENT_SECRET=
# PA_SERVER__PUBLIC_URL=https://assistant.example.com

# Notification channels (see README "Notifications")
# PA_NOTIFICATIONS__TELEGRAM__BOT_TOKEN=
# PA_NOTIFICATIONS__TELEGRAM__CHAT_ID=
# PA_NOTIFICATIONS__EMAIL__PASSWORD=
